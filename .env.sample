# dp_exchange_coinbase — environment variable template.
#
# This is the ONLY .env file that is committed. `.gitignore` carries
# `.env*` / `!.env.sample`; every other .env is yours and stays local.
#
#     cp .env.sample .env
#
# Secrets live in .env files and nowhere else. There is no `config/*.secret.exs` and no
# Vault layer.

# ---------------------------------------------------------------------------
# Tier-3 tests (authenticated, read-only) — run BY HAND, never in CI
# ---------------------------------------------------------------------------

# A Coinbase CDP key with READ-ONLY permissions. Never a trading key: nothing in this
# repo should be able to move money, and a key that cannot is the cheapest guarantee.
COINBASE_CDP_KEY_NAME=<your-cdp-key-name>
COINBASE_CDP_PRIVATE_KEY=<your-cdp-private-key>

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------

# Organisation key. CI publishes with the org secret; this is only for publishing by hand.
HEX_API_KEY=<your-hex-api-key>
